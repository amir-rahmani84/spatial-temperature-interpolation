{
  "seed": 2025,
  "data_dir": "data",
  "netcdf": "data.nc",
  "boundary": "gadm41_IRN_1.json",
  "dem": "gilan_dem_masked.csv",
  "start": "2015-01-01",
  "end": "2024-12-01",
  "projection": "EPSG:32639",
  "grid_step_degrees": 0.005,
  "bounds": [48.25, 50.75, 36.5, 38.5],
  "methods": ["IDW", "RBF Thin-Plate Spline", "RBF Multiquadric", "Ordinary Kriging", "EBK-inspired local kriging"],
  "rbf_kernels": {"RBF Thin-Plate Spline": "thin_plate", "RBF Multiquadric": "multiquadric"},
  "rbf_smooth": 0.0,
  "idw_power": 2,
  "lapse_rate_c_per_m": -0.0065,
  "ok_spherical_range_km": 55.5,
  "neighbors": 15,
  "n_lags": 10,
  "mh_iterations": 150,
  "mh_burn_in": 75,
  "sample_models": 30,
  "parameter_bounds": [[0.0, 2.0], [0.01, 4.0], [5.0, 300.0]],
  "initial_parameters": [0.01, 1.0, 100.0],
  "proposal_std": [0.005, 0.05, 5.0],
  "pseudo_residual_scale": 1.0,
  "workers": 1,
  "primary_metrics": ["MAE", "RMSE", "NSE", "Spearman"],
  "topsis_criteria": {
    "historical": {"MSE": -1, "MAE": -1, "MAPE": -1, "SMAPE": -1, "NSE": 1},
    "primary": {"MAE": -1, "RMSE": -1, "Spearman": 1},
    "reduced": {"MAE": -1, "Spearman": 1}
  },
  "results_dir": "results",
  "figures_dir": "figures"
}
